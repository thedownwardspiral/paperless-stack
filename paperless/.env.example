TZ=America/Chicago

# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
# Required since v3. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# If you are upgrading from v2 and were relying on the old built-in default
# key, setting a new value here invalidates existing sessions and API tokens.
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_URL=https://paperless.example.com # change to your paperless URL, this is used for generating links in the app

# Broker. The service is valkey, but the URL scheme stays redis://
PAPERLESS_REDIS=redis://valkey:6379

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Required since v3: the engine is no longer inferred from PAPERLESS_DBHOST
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=postgres
PAPERLESS_DBNAME=paperless #if you change this, be sure to also change it in the postgres .env
PAPERLESS_DBUSER=paperless # if you change this, be sure to also change it in the postgres .env
PAPERLESS_DBPASS=paperless # if you change this, be sure to also change it in the postgres .env (You should change this for production use)

# ------------------------------------------------------------------
# Document conversion / text extraction
# ------------------------------------------------------------------
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998

# ------------------------------------------------------------------
# AI features (native, paperless-ngx v3+)
# ------------------------------------------------------------------
# Gives you LLM-assisted suggestions, similar-document retrieval and document
# chat. All document text sent to the LLM stays on this host as long as the
# endpoint below points at the local llama-cpp service.
# Docs: https://docs.paperless-ngx.com/advanced_usage/#ai-features
PAPERLESS_AI_ENABLED=1

# LLM backend: llama-cpp's OpenAI-compatible API.
# NOTE: llama-server must run with --jinja (AI suggestions use tool calling,
# which needs the model's own chat template) AND --reasoning off (that template
# enables thinking mode, which stalls suggestions past the timeout below).
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT=http://llama-cpp:8080/v1
# Must match the model id llama-server reports at GET /v1/models
PAPERLESS_AI_LLM_MODEL=/app/models/Qwen3.5-9B-Q6_K.gguf
# llama-cpp ignores the key, but the OpenAI client requires a non-empty value
PAPERLESS_AI_LLM_API_KEY=llama-cpp
# Keep in sync with llama-cpp's per-slot context (--ctx-size / --parallel)
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
# Local inference is slower than hosted APIs; default of 120s is often too low
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300
# Required because the endpoint above resolves to a private container address
PAPERLESS_AI_LLM_ALLOW_INTERNAL_ENDPOINTS=1

# Embeddings for the LLM index (RAG). Enables document chat and
# similar-document retrieval. "huggingface" runs sentence-transformers inside
# the paperless container on CPU, so it does not compete with llama-cpp for
# VRAM. The model (~90 MB) downloads to ./paperless/data/hf_cache on first use.
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface
PAPERLESS_AI_LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# all-MiniLM-L6-v2 truncates at 256 tokens; matching the chunk size avoids
# silently discarding the tail of every chunk
PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE=256

# ------------------------------
# Secrets and local env files
# ------------------------------
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!.env.example

# Common secret/key file types
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# SSH keys (ollama keeps one in ./ollama/data/) and basicAuth password files
id_rsa*
id_ecdsa*
id_ed25519*
.htpasswd
*.htpasswd

# ------------------------------
# Runtime data (keep placeholders)
# ------------------------------
*/data/*
!*/data/.gitkeep

paperless/media/*
!paperless/media/.gitkeep

paperless/export/*
!paperless/export/.gitkeep

paperless/consume/*
!paperless/consume/.gitkeep

ollama/models/*
!ollama/models/.gitkeep

traefik/acme/*
!traefik/acme/.gitkeep

# Retired: the broker moved to valkey in v3. Ignored so a leftover local
# ./redis/ cannot be re-added by a broad `git add`.
redis/

# Retired: replaced by paperless-ngx's native AI in v3. The leftover local
# ./paperless-ai/ holds its API key and its own copy of document text
# (documents.json, search index, vector DB).
paperless-ai/

traefik/certs/*
!traefik/certs/.gitkeep

# ------------------------------
# Document data, by file type
# ------------------------------
# The directories above already cover where this data lives. These catch a
# stray copy anywhere else - a scan, an export or a backup dropped in the repo
# root. The documents contain personal information about third parties. To
# track a file of one of these types on purpose (a README screenshot, say),
# add a `!path` exception rather than removing a rule.

# Scans, originals, archived copies and thumbnails
*.pdf
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.webp
*.heic

# Exports and extracted tables
*.csv
*.tsv
*.xls
*.xlsx
*.ods
*.doc
*.docx
*.odt

# Mail consumed from mailboxes
*.eml
*.msg

# Databases, dumps, indexes and broker snapshots
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
*.rdb
*.aof
*.pkl

# Backup archives
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# ------------------------------
# Logs and temp files
# ------------------------------
*.log
*.pid
*.tmp
*.swp
*.swo

# ------------------------------
# IDE/editor files
# ------------------------------
*.code-workspace
.vscode/
.idea/

# Claude Code
.claude/
*.iml
*.suo
*.user
*.userossc
*.sln.docstates

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Docker files (optional, if you want to ignore them)
docker-compose.override.yaml
docker-compose.override.yml

# ------------------------------
# Other files you may want to ignore
# ------------------------------
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp
*.log
*.cache
*.pid
*.swp
*.swo
acme.json
*.gguf
*.crt
*.tmpl
traefik/traefik.dynamic.yml
traefik/traefik.yml
# Live compose files carry real hostnames; only compose.yaml.example is tracked
compose.yaml
compose.yml
docker-compose.yaml
docker-compose.yml
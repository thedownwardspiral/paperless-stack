TZ=America/Chicago
PAPERLESS_URL=http://paperless:8000
# Paperless API token: Profile > API Tokens > Generate
PAPERLESS_TOKEN=change-me
# Where export_csv writes files. Mounted from ./paperless/export in compose.
EXPORT_DIR=/export
# Caps on tool output, to keep responses inside the model's context window.
# Sized for a fan-out, not a single call: the model issues parallel
# get_document_content calls (observed 9 in one turn) despite the tool
# description telling it to read one at a time. 9 x 6000 chars still fits
# llama-cpp's 8192-token per-slot context. Raise only if you also raise
# PAPERLESS_AI_LLM_CONTEXT_SIZE and llama-cpp's --ctx-size / --parallel.
MAX_CONTENT_CHARS=6000
MAX_SEARCH_RESULTS=50

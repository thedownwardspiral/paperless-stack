TZ=America/Chicago

# WARNING: almost everything below is a PersistentConfig setting. Open WebUI
# reads these only to seed its database on FIRST boot; after that the database
# wins and edits here are silently ignored. Against an existing
# ./open-webui/data/webui.db, configure these in the UI instead:
#   connections -> Admin Panel > Settings > Connections
#   accounts    -> Admin Panel > Settings > Authentication (or Users)

# llama-cpp's OpenAI-compatible API. llama-cpp must run with --jinja for tool
# calling, which the paperless-tools integration depends on.
# UI equivalent: Admin Panel > Settings > Connections > OpenAI API,
# Base URL http://llama-cpp:8080/v1, Auth None, Provider llama.cpp.
OPENAI_API_BASE_URL=http://llama-cpp:8080/v1
OPENAI_API_KEY=llama-cpp

# Ollama is not used in this stack; blank it so Open WebUI stops probing for it
OLLAMA_BASE_URL=

# Accounts are required, and only an admin can create them. Traefik basicAuth
# sits in front of this as a second layer.
WEBUI_AUTH=True
ENABLE_SIGNUP=False
# Signing key for sessions. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
WEBUI_SECRET_KEY=change-me
WEBUI_URL=https://open-webui.example.com

# The stack has no internet-facing search or image generation wired up
ENABLE_WEB_SEARCH=False
ENABLE_IMAGE_GENERATION=False
